{
  "name": "us-college-application-consultant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import tsx server.mjs",
    "worker": "node --import tsx worker.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check-syntax.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "prompt:check": "tsx scripts/verify-prompt-manifest.ts",
    "contracts:compat": "tsx scripts/check-contract-compatibility.ts",
    "contracts:check": "npm run typecheck && npm run openapi:check && npm run prompt:check && npm run contracts:compat",
    "eval:ai": "node --import tsx scripts/evaluate-ai-quality.mjs",
    "eval:retrieval": "node --import tsx scripts/evaluate-retrieval-golden.mjs",
    "eval:graph-rag": "node --import tsx scripts/evaluate-graph-rag-golden.mjs",
    "eval:rag-relevance": "node --import tsx scripts/evaluate-rag-relevance-golden.mjs",
    "ci": "npm run verify",
    "verify": "npm run check && npm run contracts:check && npm test && npm run eval:retrieval && npm run eval:graph-rag && npm run eval:rag-relevance",
    "db:status": "node scripts/db.mjs status",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:rollback": "node scripts/db.mjs rollback",
    "db:backup": "node scripts/db.mjs backup",
    "db:restore": "node scripts/db.mjs restore",
    "db:seed-admin": "node scripts/db.mjs seed-admin",
    "db:pg:migrate": "node --import tsx scripts/migrate-postgres.mjs",
    "db:import:postgres": "node --import tsx scripts/import-sqlite-to-postgres.mjs",
    "db:cutover": "node --import tsx scripts/cutover-postgres.mjs",
    "knowledge:ingest": "node --import tsx scripts/ingest-markdown.mjs",
    "test:infra": "node --import tsx scripts/run-infrastructure-tests.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "gcp-metadata": {
      "gaxios": "7.3.0"
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@langchain/core": "^1.2.1",
    "@langchain/deepseek": "^1.1.3",
    "@langchain/langgraph": "^1.4.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@sentry/node": "^10.65.0",
    "better-sqlite3": "^12.10.0",
    "bullmq": "^5.80.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "tsx": "^4.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.0.4",
    "typescript": "^5.9.3"
  }
}
