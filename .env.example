# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4177
APP_BASE_URL=http://localhost:4177
COOKIE_SECURE=false

# Fastify strangler rollout. The RAG stream route is always available;
# these settings control the other migrated routes with deterministic request/cookie selection.
FASTIFY_HTTP_ENABLED=true
FASTIFY_HTTP_TRAFFIC_PERCENT=100
TRUST_PROXY=false
RAG_STREAM_RATE_LIMIT=20

# Database
AUTH_DATABASE_PATH=./data/auth.sqlite
DATABASE_BACKUP_DIR=./backups/sqlite
DATABASE_URL=
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
PG_SSL=false
WRITE_PAUSE_FILE=./work/maintenance/write-paused.lock

# Redis / BullMQ. Leave REDIS_URL empty to keep the in-memory development fallback.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=1000
JOB_QUEUE_NAME=consultant-jobs
WORKER_CONCURRENCY=4
JOB_HANDLER_MODULE=./src/worker/default-handlers.mjs

# Object storage: local, minio, s3, or r2.
OBJECT_STORE_DRIVER=local
OBJECT_STORE_LOCAL_PATH=./storage
OBJECT_STORE_SIGNING_SECRET=replace-with-at-least-16-random-characters
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_PUBLIC_ENDPOINT=
OBJECT_STORE_REGION=auto
OBJECT_STORE_BUCKET=consultant-exports
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_FORCE_PATH_STYLE=false
OBJECT_SIGNED_URL_TTL_SECONDS=300

# OpenAI-compatible embedding endpoint used by pgvector ingestion.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_MS=30000
KNOWLEDGE_SOURCE_VERSION=

# Optional low-latency cross-encoder reranker (for example a private FastAPI BGE service).
RERANKER_URL=
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_MS=350

# Retrieval-only cache. Keys hash normalized queries; values contain only knowledge retrieval results.
RETRIEVAL_CACHE_NAMESPACE=rag-retrieval-v1
RETRIEVAL_CACHE_TTL_SECONDS=300
RETRIEVAL_CACHE_COMMAND_TIMEOUT_MS=200

# First admin seed. Never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-this-password

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_PLAN_MODEL=deepseek-v4-flash
DEEPSEEK_PLAN_TIMEOUT_MS=75000
DEEPSEEK_RAG_MODEL=deepseek-v4-pro
DEEPSEEK_RAG_MAX_TOKENS=1600
DEEPSEEK_MAJOR_MATCH_MAX_TOKENS=2200
DEEPSEEK_RAG_MAX_ANSWER_CHARS=12000
DEEPSEEK_SCHOOL_SELECTION_MODEL=deepseek-v4-flash
DEEPSEEK_CAPABILITY_ASSESSMENT_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro

# Inspiration robot: dedicated Volcengine Ark key and low-latency Doubao model.
INSPIRATION_API_KEY=
INSPIRATION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
INSPIRATION_MODEL=doubao-seed-2-1-turbo-260628
INSPIRATION_MAX_TOKENS=600
INSPIRATION_FALLBACK_MODEL=

AI_TIMEOUT_MS=30000
AI_MAX_ATTEMPTS=3
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RESET_MS=30000

# Observability. Payloads, prompts, student text and secrets are never exported.
LOG_LEVEL=info
OTEL_SERVICE_NAME=us-college-consultant
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SDK_DISABLED=false
SENTRY_DSN=
APP_RELEASE=

# SMTP for password reset emails
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
