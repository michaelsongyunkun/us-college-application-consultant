# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4177
APP_BASE_URL=http://localhost:4177
COOKIE_SECURE=false

# Database
AUTH_DATABASE_PATH=./data/auth.sqlite
DATABASE_BACKUP_DIR=./backups/sqlite

# First admin seed. Never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-this-password

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_PLAN_MODEL=deepseek-v4-flash
DEEPSEEK_RAG_MODEL=deepseek-v4-pro
DEEPSEEK_SCHOOL_SELECTION_MODEL=deepseek-v4-flash
DEEPSEEK_CAPABILITY_ASSESSMENT_MODEL=deepseek-v4-flash

# SMTP for password reset emails
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
